{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "elements": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/elements/{**remainder}"
        }
      },
      "substances": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/substances/{**remainder}"
        }
      },
      "reactions": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/reactions/{**remainder}"
        }
      },
      "chemistry": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/chemistry/{**remainder}"
        }
      },
      "catalog-answers": {
        "ClusterId": "catalog",
        "Order": -1,
        "Match": {
          "Path": "/catalog/v1/releases/{**remainder}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      },
      "releases": {
        "ClusterId": "releases",
        "Match": {
          "Path": "/catalog/{**remainder}",
          "Methods": [ "GET", "HEAD" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" },
          { "RequestHeaderRemove": "Cookie" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeaderRemove": "Set-Cookie", "When": "Always" }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "HttpRequest": {
          "Version": "1.1"
        },
        "Destinations": {
          "catalog": {
            "Address": "https+http://catalog"
          }
        }
      },
      "releases": {
        "HttpRequest": {
          "Version": "1.1"
        }
      }
    }
  }
}
