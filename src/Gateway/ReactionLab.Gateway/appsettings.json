{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "elements": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/elements/{**remainder}"
        }
      },
      "substances": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/substances/{**remainder}"
        }
      },
      "reactions": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/reactions/{**remainder}"
        }
      },
      "chemistry": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/chemistry/{**remainder}"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "HttpRequest": {
          "Version": "1.1"
        },
        "Destinations": {
          "catalog": {
            "Address": "https+http://catalog"
          }
        }
      }
    }
  }
}
