<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\aspire\ReactionLab.ServiceDefaults\ReactionLab.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ReactionLab.Web\ReactionLab.Web.csproj" />
    <ProjectReference Include="..\ReactionLab.Identity.Persistence\ReactionLab.Identity.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MyCSharp.HttpUserAgentParser" />
    <PackageReference Include="OpenIddict.Client.AspNetCore" />
    <PackageReference Include="OpenIddict.Client.SystemNetHttp" />
    <PackageReference Include="OpenIddict.Client.WebIntegration" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\ReactionLab.Identity.Contracts\Protos\contacts.proto" Link="Protos\contacts.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Internal</Access>
    </Protobuf>
    <Protobuf Include="..\ReactionLab.Identity.Contracts\Protos\security_links.proto"
              Link="Protos\security_links.proto">
      <GrpcServices>Server</GrpcServices>
      <Access>Internal</Access>
    </Protobuf>
  </ItemGroup>
  <PropertyGroup>
    <UserSecretsId>reactionlab-identity</UserSecretsId>
  </PropertyGroup>
</Project>
