# Normalise line endings in the index. Working trees get LF on checkout,
# so behaviour no longer depends on each developer's core.autocrlf setting.
* text=auto eol=lf

# --- Explicit text ------------------------------------------------------------
*.cs           text eol=lf diff=csharp
*.csproj       text eol=lf
*.props        text eol=lf
*.targets      text eol=lf
*.slnx         text eol=lf
*.sln          text eol=crlf
*.config       text eol=lf
*.json         text eol=lf
*.jsonl        text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.xml          text eol=lf
*.md           text eol=lf
*.ts           text eol=lf
*.js           text eol=lf
*.mjs          text eol=lf
*.html         text eol=lf
*.scss         text eol=lf
*.css          text eol=lf
*.svg          text eol=lf
*.glsl         text eol=lf
*.sdf          text eol=lf
*.sh           text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf

# Windows tooling requires CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# --- Binary -------------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.dll  binary
*.exe  binary
*.pdb  binary
*.snk  binary
*.hdr  binary
*.exr  binary
*.ktx2 binary
*.glb  binary
*.wasm binary
*.mp4  binary
*.webm binary

# --- Diff / linguist ----------------------------------------------------------
package-lock.json  linguist-generated=true -diff
*.Designer.cs      linguist-generated=true -diff
**/Migrations/**   linguist-generated=true
data/catalog/**    linguist-generated=true
*.min.js           linguist-generated=true -diff
*.min.css          linguist-generated=true -diff

reaction-lab-client/** linguist-detectable=true
docs/**                linguist-documentation=true